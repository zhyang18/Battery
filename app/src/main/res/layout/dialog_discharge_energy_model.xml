<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical">

    <!-- 顶部固定栏（Header）：拖动手柄与标题，圆角永不消失 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_history_badge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/energy_model_dialog_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/energy_model_dialog_subtitle"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_reset_energy_model_header"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_power_reset"
                app:tint="?android:attr/textColorSecondary" />

            <ImageView
                android:id="@+id/btn_close_energy_model"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="?android:attr/textColorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中间滚动区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- 【板块一：三源能量对比与学习状态看板】 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_diag_sub_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/energy_model_overview_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_model_coverage_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_diag_pill_badge"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3.5dp"
                        android:textColor="#3b82f6"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        tools:text="覆盖率 80.0% (学习中)" />
                </LinearLayout>

                <!-- 双重条件过滤器胶囊栏（单次放电门限 + 时效有效条数） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discharge_filter_label"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/tv_discharge_threshold_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_diag_pill_badge"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#10b981"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        tools:text="门限: > 15% ▾" />

                    <TextView
                        android:id="@+id/tv_discharge_count_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_diag_pill_badge"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#3b82f6"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        tools:text="最近 10 条 ▾" />
                </LinearLayout>

                <!-- 三源对比：纵向每行显示（实测学习 | 硬件直读 | 传统标称） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <!-- 行1：实测学习模型 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="3dp">

                        <!-- 主行：标题与大字满充能量值 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:singleLine="true"
                                android:text="@string/energy_col_learned_label"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_val_learned_energy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:gravity="end"
                                android:singleLine="true"
                                android:textColor="#10b981"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="25.26 ± 0.22 Wh" />
                        </LinearLayout>

                        <!-- 第二行：能量健康度（独占整行，大字醒目，绝不被截断） -->
                        <TextView
                            android:id="@+id/tv_hint_learned_energy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.5dp"
                            android:gravity="start"
                            android:singleLine="true"
                            android:textColor="#10b981"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            tools:text="能量健康度 82.0% (折合 6560 mAh)" />

                        <!-- 第三行：实测掉电数据与锚定状态说明（左右并列分布，完整展示） -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_val_learned_coverage"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="10.5sp"
                                tools:text="亮屏 12.34 Wh (掉电 48.0%)" />

                            <TextView
                                android:id="@+id/tv_val_model_sessions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:gravity="end"
                                android:singleLine="true"
                                android:textColor="#64748b"
                                android:textSize="10sp"
                                tools:text="亮屏连续高频实测锚定" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 分割线 1 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.6dp"
                        android:layout_marginVertical="7dp"
                        android:background="?android:attr/textColorSecondary"
                        android:alpha="0.12" />

                    <!-- 行2：硬件电量计原生直读 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="3dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/energy_col_hardware_label"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/energy_col_hardware_source"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_val_hardware_energy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="15.5sp"
                                android:textStyle="bold"
                                tools:text="--" />

                            <TextView
                                android:id="@+id/tv_val_hardware_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="end"
                                android:text="@string/energy_col_hardware_unsupported"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="10sp"
                                tools:text="底层硬件不支持" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 分割线 2 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.6dp"
                        android:layout_marginVertical="7dp"
                        android:background="?android:attr/textColorSecondary"
                        android:alpha="0.12" />

                    <!-- 行3：传统标称平台折算 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="3dp">

                        <!-- 主行：标题与出厂设计理论值 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_label_nominal_energy"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:singleLine="true"
                                android:text="@string/energy_col_nominal_label"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_val_nominal_energy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:gravity="end"
                                android:singleLine="true"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="30.80 Wh" />
                        </LinearLayout>

                        <!-- 第二行：容量模型健康度对照（独占整行，完整展示，绝不截断） -->
                        <TextView
                            android:id="@+id/tv_desc_nominal_energy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.5dp"
                            android:gravity="start"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="11.5sp"
                            tools:text="容量模型健康度 78.1% (6247 mAh | 24.05 Wh)" />

                        <!-- 第三行：出厂设计容量与理论基准说明（独占整行，清晰底注） -->
                        <TextView
                            android:id="@+id/tv_hint_nominal_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="start"
                            android:singleLine="true"
                            android:text="@string/energy_col_nominal_desc"
                            android:textColor="#64748b"
                            android:textSize="10sp"
                            tools:text="出厂设计 8000 mAh · 理论无损基准" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 【板块二：本次升级核心原理与电化学突破（序号独立分列，正文换行严格对齐第一行文字）】 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_diag_sub_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/energy_model_theory_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 原理条目 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/energy_model_theory_p1"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- 原理条目 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/energy_model_theory_p2"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- 原理条目 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/energy_model_theory_p3"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 【板块三：20 段 SOC (5% Bin) 实测能量释放分布】 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_diag_sub_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:autoSizeTextType="uniform"
                        app:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9.5sp"
                        app:autoSizeMinTextSize="9.5sp"
                        android:autoSizeMaxTextSize="12sp"
                        app:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="0.5sp"
                        app:autoSizeStepGranularity="0.5sp"
                        android:text="@string/energy_model_bins_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_bins_summary_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp"
                        tools:text="已学习 13 / 20 段" />
                </LinearLayout>

                <!-- 20 段 SOC 区间列表容器 -->
                <LinearLayout
                    android:id="@+id/layout_bins_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 【板块四：零假数据与严谨工况声明】 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_diag_warning_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/energy_model_statement_title"
                    android:textColor="#f59e0b"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/energy_model_statement_desc"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- 底部操作区：重置模型与确认关闭 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_energy_model_reset"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:text="@string/energy_model_reset_btn"
                    android:textColor="#ef4444"
                    android:textSize="13.5sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_power_reset"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconTint="#ef4444"
                    app:strokeColor="#50ef4444"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_energy_model_confirm"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1.3"
                    android:backgroundTint="#3b82f6"
                    android:text="@string/confirm"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
