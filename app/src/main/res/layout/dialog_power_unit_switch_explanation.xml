<?xml version="1.0" encoding="utf-8"?>
<!--
    电量显示单位（Wh / mAh）切换科学原理与物理守恒说明弹窗布局。
    采用现代化卡片层次结构，融合公式高亮徽标、物理定义与科学依据清单，提供优雅清晰的科普呈现。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_surface"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="20dp">

    <!-- 顶部居中圆形图标容器 -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_unit_dialog_icon_circle">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_swap_horiz"
            app:tint="#2196F3" />
    </FrameLayout>

    <!-- 弹窗主标题 -->
    <TextView
        android:id="@+id/tv_unit_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="17.5sp"
        android:textStyle="bold"
        tools:text="已切换为【毫安时 (mAh)】显示" />

    <!-- 弹窗副标题 -->
    <TextView
        android:id="@+id/tv_unit_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        tools:text="展现层单位切换 · 严谨物理守恒" />

    <!-- 滚动内容区 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 卡片 1：核心换算公式卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
        android:background="@drawable/bg_dialog_card"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/power_unit_dialog_formula_desc"
                android:src="@drawable/ic_battery_power"
                app:tint="#2196F3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/power_unit_dialog_formula_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 公式高亮容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dialog_formula_badge"
            android:clipToOutline="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="9dp">

            <TextView
                android:id="@+id/tv_unit_dialog_formula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2196F3"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="电量 (mAh) = 能量 (Wh) × 1000 ÷ 3.85V" />

            <TextView
                android:id="@+id/tv_unit_dialog_example"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11.5sp"
                tools:text="换算参考：1.000 Wh ≈ 259.7 mAh" />
        </LinearLayout>
    </LinearLayout>

    <!-- 卡片 2：科学依据与特性卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_card"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 物理定义 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/power_unit_dialog_def_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_unit_dialog_definition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="电荷量物理单位（Q = I × t），符合手机电池出厂标称容量（如 5000mAh）的日常直觉感知。" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#0D888888" />

        <!-- 科学守恒 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/power_unit_dialog_science_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_unit_dialog_science"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="杜绝使用随负载跳变的瞬时端电压逆算，保证所有应用耗电总和与整机掉电在数学与物理上完全守恒。" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 不再提示复选框 -->
    <CheckBox
        android:id="@+id/cb_unit_dialog_donot_show"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:buttonTint="#2196F3"
        android:text="@string/power_unit_dialog_dont_show_again"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <!-- 底部确认按钮 -->
    <TextView
        android:id="@+id/btn_unit_dialog_confirm"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/understood"
        android:textColor="@color/nav_item_selected"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
