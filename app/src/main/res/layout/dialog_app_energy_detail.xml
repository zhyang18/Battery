<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- 顶部拖拽把手指示条 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_history_badge" />

    <!-- 头部：应用图标与名称、包名 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_detail_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_name"
            tools:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="微信" />

            <TextView
                android:id="@+id/tv_detail_package"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#888888"
                android:textSize="12sp"
                tools:text="com.tencent.mm (UID: 10185)" />
        </LinearLayout>

        <!-- 置信度标签 -->
        <TextView
            android:id="@+id/tv_detail_confidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_history_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#2196F3"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="可信度: 高" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#15888888" />

    <!-- 核心能耗指标矩阵 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 消耗能量 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消耗能量"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_detail_energy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#34C759"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="18.4 mWh" />
        </LinearLayout>

        <!-- 平均功耗 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="平均功耗"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_detail_avg_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#2196F3"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="806 mW" />
        </LinearLayout>

        <!-- 峰值功耗 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="峰值功耗"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_detail_peak_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF9800"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="1.42 W" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#15888888" />

    <!-- 详细运行时间与硬件开销 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 时间跨度 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="活动时间"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_detail_time_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                tools:text="14:58:10 - 14:59:32 (1m 22s)" />
        </RelativeLayout>

        <!-- CPU 时间 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU 运行时间"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_detail_cpu_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                tools:text="45s" />
        </RelativeLayout>

        <!-- 网络流量 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网络流量"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_detail_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                tools:text="15.2 MB" />
        </RelativeLayout>

        <!-- 唤醒锁 / GPS -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wakelock / 定位"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_detail_wakelock_gps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                tools:text="锁: 12s | GPS: 0s" />
        </RelativeLayout>

        <!-- 数据来源 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数据来源"
                android:textColor="#888888"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_detail_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                tools:text="BatteryStats (系统账本)" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
