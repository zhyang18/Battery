<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶部导航栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cancel"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/power_detail_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 载入至主页按钮 -->
        <TextView
            android:id="@+id/btn_load_to_main"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_filter_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/power_detail_btn_load"
            android:textColor="@color/nav_item_selected"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 删除按钮 -->
        <ImageView
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/delete"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:tint="?android:attr/textColorPrimary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A888888" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 卡片 1：放电时段与电量状态 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#14888888"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_mode_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_history_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="#2196F3"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Shizuku" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_detail_time_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp"
                            tools:text="2026/09/07 12:26 ~ 13:12" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#14888888" />

                    <!-- 电量、温度、电压与能量 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/power_detail_level"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_detail_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="69%" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/power_detail_temp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_detail_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="32.0 ℃" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/power_detail_voltage"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_detail_voltage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="4.12 V" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/power_detail_energy"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_detail_energy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="14.2 Wh" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片 2：三维核心功耗与续航指标（与耗电页顶部卡片一致） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_power_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:cardBackgroundColor="#14888888"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="5dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="10dp">

                    <!-- 第一行：亮屏数据（前置亮色太阳图标，时长占比 / 能量占比 / 功耗 / 续航） -->
                    <LinearLayout
                        android:id="@+id/layout_metric_screen_on_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_icon_screen_on"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="@string/power_header_screen_on"
                            android:src="@drawable/ic_power_screen_on" />

                        <TextView
                            android:id="@+id/tv_metric_screen_on_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="13m44s(45.1%)" />

                        <TextView
                            android:id="@+id/tv_metric_screen_on_energy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0.406Wh(45.1%)" />

                        <TextView
                            android:id="@+id/tv_metric_screen_on_power"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="1.77W" />

                        <TextView
                            android:id="@+id/tv_metric_screen_on_remaining"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="9h19m" />
                    </LinearLayout>

                    <!-- 第二行：息屏数据（前置暗色太阳图标，时长占比 / 能量占比 / 功耗 / 续航） -->
                    <LinearLayout
                        android:id="@+id/layout_metric_screen_off_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_icon_screen_off"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="@string/power_header_screen_off"
                            android:src="@drawable/ic_power_screen_off" />

                        <TextView
                            android:id="@+id/tv_metric_screen_off_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="49m55s(54.9%)" />

                        <TextView
                            android:id="@+id/tv_metric_screen_off_energy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0.494Wh(54.9%)" />

                        <TextView
                            android:id="@+id/tv_metric_screen_off_power"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0.59W" />

                        <TextView
                            android:id="@+id/tv_metric_screen_off_remaining"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="1d03h" />
                    </LinearLayout>

                    <!-- 第三行：全局数据（前置半亮半暗太阳图标，时长占比 / 能量占比 / 功耗 / 续航） -->
                    <LinearLayout
                        android:id="@+id/layout_metric_global_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_icon_global"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="@string/power_header_global"
                            android:src="@drawable/ic_power_global" />

                        <TextView
                            android:id="@+id/tv_metric_global_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="1h03m(100%)" />

                        <TextView
                            android:id="@+id/tv_metric_global_energy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0.900Wh(100%)" />

                        <TextView
                            android:id="@+id/tv_metric_global_power"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0.85W" />

                        <TextView
                            android:id="@+id/tv_metric_global_remaining"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="19h26m" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片 3：放电走势图 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:cardBackgroundColor="#14888888"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/power_detail_chart_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.battery.analysis.timeline.presentation.BatteryTimelineView
                        android:id="@+id/battery_timeline_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                    <com.battery.analysis.timeline.presentation.MetricSelectorView
                        android:id="@+id/metric_selector_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片 4：应用耗电列表 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#14888888"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_app_list_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/power_detail_apps_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_app_usage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_app_power_usage" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
