<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="20dp">

    <!-- 弹窗标题与副标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/charging_guide_dialog_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/charging_guide_dialog_subtitle"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <!-- 滚动内容区 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxHeight="450dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 卡片 1: 充电多维走势图表 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/charging_guide_chart_title"
                    android:textColor="#2196F3"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/charging_guide_chart_summary"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp" />

                <!-- 条目 1: 功率曲线 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_curve_power"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 条目 2: 电量曲线 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_curve_level"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 条目 3: 温度曲线 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_curve_temp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 卡片 2: 充电总览关键指标 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/charging_guide_overview_title"
                    android:textColor="@color/nav_item_selected"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 条目 1: 充入能量 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_metric_energy"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 条目 2: 峰值功率 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_metric_peak"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 条目 3: 平均功率 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_metric_avg"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 条目 4: 最高温度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_metric_temp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 卡片 3: 息屏快充细分统计 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/charging_guide_screen_off_title"
                    android:textColor="#818CF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/charging_guide_screen_off_summary"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 卡片 4: 采样模式与自动归档 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/charging_guide_archive_title"
                    android:textColor="#10B981"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 条目 1: 智能双模 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_archive_mode"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 条目 2: 常亮选项 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="•"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/charging_guide_archive_screen"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部确认按钮 -->
    <TextView
        android:id="@+id/btn_dialog_charging_guide_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dialog_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/understood"
        android:textColor="@color/nav_item_selected"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
