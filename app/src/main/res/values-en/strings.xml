    <!-- Discharge Process Guide Dialog -->
    <string name="power_guide_process_dialog_subtitle">Discharge history curve and real-time telemetry</string>
    <string name="power_guide_process_curve_title">Battery Level Trend Curve</string>
    <string name="power_guide_process_curve_desc">Displays the dynamic curve of battery percentage over time since the last discharge (or boot), showing battery drain slope and drop rate.</string>
    <string name="power_guide_process_markers_title">High-Drain App Markers</string>
    <string name="power_guide_process_markers_desc">Automatically flags foreground active applications during rapid battery drop or high-load periods to help identify battery drain culprits.</string>
    <string name="power_guide_process_params_title">Real-time Telemetry Metrics</string>
    <string name="power_guide_process_params_desc">• Energy (Wh): Current remaining battery energy reserve.\n• Temperature (℃): Real-time battery cell operating temperature.\n• Voltage (V): Real-time terminal voltage of the battery.\n• Status: Indicates discharging or connected charging device.</string>

    <!-- Usage Scenarios Guide Dialog -->
    <string name="power_guide_scene_dialog_subtitle">Foreground app power profiles and efficiency analysis</string>
    <string name="power_guide_scene_metrics_title">Core Metrics</string>
    <string name="power_guide_scene_metrics_desc">• Duration: Cumulative foreground active time of the application.\n• AVG Power: Average total system discharge power while running (W).\n• Temperature: Average (AVG) and maximum (MAX) temperature during execution.\n• Energy Consumed: Real energy consumption (mAh) and percentage of total discharge.</string>
    <string name="power_guide_scene_modes_title">Dual Data Collection Modes</string>
    <string name="power_guide_scene_modes_desc">• ⚡ Shizuku Mode: Directly reads dumpsys batterystats authority log from system framework for precise data.\n• 📊 Standard Mode: Scientifically estimated via Android UsageStats and platform hardware power profile.</string>
    <string name="power_guide_scene_tips_title">Sorting and Quick Interactions</string>
    <string name="power_guide_scene_tips_desc">• Toggle Button (⇄): Quickly cycles through sorting by duration, power, and energy consumed.\n• Filter Button: Opens menu for precise sorting by multiple dimensions.</string>

