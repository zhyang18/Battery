<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部操作与标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="历史记录"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_history_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_history_badge"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            tools:text="共 0 条" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 顶部操作 1: 保存当前快照按钮 -->
        <LinearLayout
            android:id="@+id/btn_save_snapshot"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_badge_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_add_snapshot"
                app:tint="#2196F3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="保存快照"
                android:textColor="#2196F3"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 顶部操作 2: 一键清空按钮 -->
        <ImageView
            android:id="@+id/btn_clear_history"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:src="@drawable/ic_delete"
            app:tint="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- 等宽均分分类筛选栏（4个标签等宽占满整行） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btn_filter_all"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="全部"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_filter_normal"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="系统api"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_filter_shizuku"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Shizuku"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_filter_bugreport"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="错误报告"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A888888" />

    <!-- 列表容器与下拉刷新 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 历史记录列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="8dp"
                tools:listitem="@layout/item_history_record" />

            <!-- 空状态提示视图 -->
            <LinearLayout
                android:id="@+id/layout_empty_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="16dp"
                    android:alpha="0.4"
                    android:src="@drawable/ic_nav_history"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无电池检测记录"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_empty_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="点击右上角或下方按钮，可一次性同时保存【系统api、Shizuku、错误报告】的全部检测数据。"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_empty_save_snapshot"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#2196F3"
                    android:text="立即保存当前快照"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:cornerRadius="22dp" />

            </LinearLayout>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
