<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_surface"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="10dp">

    <!-- 弹窗标题与副标题 -->
    <TextView
        android:id="@+id/tv_dialog_decay_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_decay_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_decay_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dialog_decay_subtitle"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12.5sp" />

    <!-- 滚动内容区 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 卡片 1: 衰减速率统计概览 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_decay_rate_title"
                    android:textColor="#2196F3"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- 日、月、年三个等宽并列卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- 每日衰减 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tv_modal_daily_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#EF4444"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            tools:text="-0.02%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_daily_avg"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 每月衰减 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tv_modal_monthly_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#EF4444"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            tools:text="-0.61%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_monthly_avg"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 每年衰减 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tv_modal_yearly_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#EF4444"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            tools:text="-7.30%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_yearly_est"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 循环消耗速率副标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/dialog_decay_cycle_rate_title"
                    android:textColor="#3B82F6"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- 循环消耗日、月、年三个等宽并列卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- 每日消耗 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tv_modal_daily_cycle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#3B82F6"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            tools:text="+0.50 次" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_cycle_daily"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 每月消耗 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tv_modal_monthly_cycle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#3B82F6"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            tools:text="+15.2 次" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_cycle_monthly"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 每年预估 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tv_modal_yearly_cycle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#3B82F6"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            tools:text="+182 次" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_cycle_yearly"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 采样与汇总辅助信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_dialog_formula_badge"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tv_modal_stat_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp"
                        tools:text="• 有效采样快照: 8 次\n• 采样时间跨度: 12.5 天 (08-06 ~ 08-18)\n• 累计健康度变化: 98.50% → 98.25% (衰减 0.25%)\n• 累计循环消耗: +15 次 (120 次 → 135 次)" />
                </LinearLayout>
            </LinearLayout>

            <!-- 卡片 2: 周期实际损耗明细 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dialog_decay_periodic_title"
                        android:textColor="@color/nav_item_selected"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <!-- 周期切换筛选标签（按日、按月、按年顺序排列） -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_tab_day"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_filter_chip_selected"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/tab_by_day"
                            android:textColor="@color/nav_item_selected"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_tab_month"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_filter_chip_normal"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/tab_by_month"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/btn_tab_year"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_filter_chip_normal"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/tab_by_year"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 周期列表动态容器 -->
                <LinearLayout
                    android:id="@+id/layout_periodic_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <!-- 明细为空时的占位提示 -->
                <TextView
                    android:id="@+id/tv_periodic_empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="@string/empty_periodic_records"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 卡片 3: 衰减计算算法说明 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_decay_formula_title"
                    android:textColor="#10B981"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/dialog_decay_formula_desc"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部确认关闭按钮 -->
    <TextView
        android:id="@+id/btn_dialog_decay_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dialog_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/understood"
        android:textColor="@color/nav_item_selected"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
