<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_sleep_awake_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:weightSum="3">

    <!-- 卡片 1：息屏时间与能耗 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_screen_off"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="8dp">

            <!-- 第一行：百分比数值 + 息屏标签文字（无圆点，16sp 粗体与上方放电速度卡片一致） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_screen_off_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="6.3%" />

                <TextView
                    android:id="@+id/tv_screen_off_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/power_metric_screen_off"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：息屏时长与消耗能量 -->
            <TextView
                android:id="@+id/tv_screen_off_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10.5sp"
                tools:text="45m20s 0.543Wh" />

            <!-- 第三行：息屏消耗电荷量 -->
            <TextView
                android:id="@+id/tv_screen_off_mah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10.5sp"
                tools:text="141.0 mAh" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 卡片 2：唤醒时间与能耗 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_awake"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="8dp">

            <!-- 第一行：百分比数值 + 唤醒标签文字（无圆点，16sp 粗体与上方放电速度卡片一致） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_awake_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="2.2%" />

                <TextView
                    android:id="@+id/tv_awake_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/power_metric_awake"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：唤醒时长与消耗能量（浅红高亮） -->
            <TextView
                android:id="@+id/tv_awake_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10.5sp"
                tools:text="4m10s 0.123Wh" />

            <!-- 第三行：唤醒消耗电荷量（浅红高亮） -->
            <TextView
                android:id="@+id/tv_awake_mah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10.5sp"
                tools:text="32.0 mAh" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 卡片 3：深度睡眠时间与能耗 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_deep_sleep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="8dp">

            <!-- 第一行：百分比数值 + 深度睡眠标签文字（无圆点，16sp 粗体与上方放电速度卡片一致） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_sleep_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="4.1%" />

                <TextView
                    android:id="@+id/tv_sleep_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/power_metric_deep_sleep"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：深度睡眠时长与消耗能量（深红/暗红高亮） -->
            <TextView
                android:id="@+id/tv_sleep_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10.5sp"
                tools:text="41m10s 0.420Wh" />

            <!-- 第三行：深度睡眠消耗电荷量（深红/暗红高亮） -->
            <TextView
                android:id="@+id/tv_sleep_mah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10.5sp"
                tools:text="109.0 mAh" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
