<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 详细参数列表卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <!-- 1. 电量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 电量"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="85%" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 2. 电池状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ 电池状态"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="放电中" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 3. 电池健康 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🩺 电池健康"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_health_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="良好" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 4. 健康度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="❤️ 健康度"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_health_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="98.50%" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 5. 循环计数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔄 循环计数"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_cycle_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="152" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 6. 电池温度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌡️ 电池温度"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="28.5℃" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 7. 电池电压 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 电池电压"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_voltage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="4120 mV" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 8. 电流 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ 瞬时电流"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="-320 mA" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 9. 电池功率 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ 电池功率"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="1.32 W" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 10. 设计容量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 设计容量"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_design_capacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="5000.0 mAh" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 11. 充满容量 (原充满电容量，移至当前容量上方) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 充满容量"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_full_capacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="4920.0 mAh" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 12. 当前容量 (移至充满容量下方) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 当前容量"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_current_capacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="4250.0 mAh" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 13. 双电芯 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 双电芯"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_dual_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="否" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#14888888" />

        <!-- 14. 电池技术 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="7dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔬 电池技术"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_val_technology"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Li-ion" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
