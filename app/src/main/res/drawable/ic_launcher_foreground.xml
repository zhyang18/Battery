<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 进一步缩小至小巧极简比例 (0.46) -->
    <group
        android:scaleX="0.46"
        android:scaleY="0.46"
        android:pivotX="54"
        android:pivotY="54">

        <!-- 1. 电池顶部电极极耳（极简圆角） -->
        <path
            android:pathData="M48,22 h12 a2,2 0 0,1 2,2 v4 h-16 v-4 a2,2 0 0,1 2,-2 z"
            android:fillColor="#E2E8F0" />

        <!-- 2. 电池极简主体外框 -->
        <path
            android:pathData="M35,28 h38 a8,8 0 0,1 8,8 v48 a8,8 0 0,1 -8,8 h-38 a8,8 0 0,1 -8,-8 v-48 a8,8 0 0,1 8,-8 z"
            android:strokeWidth="3.2"
            android:strokeColor="#FFFFFF"
            android:fillColor="#1500E5FF" />

        <!-- 3. 内部纯净能量渐变色块 -->
        <path
            android:pathData="M37,44 h34 v30 a6,6 0 0,1 -6,6 h-22 a6,6 0 0,1 -6,-6 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="44"
                    android:endX="54"
                    android:endY="80"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00E676" />
                    <item android:offset="1.0" android:color="#00B0FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 4. 极简闪电符号 -->
        <path
            android:pathData="M56,36 L44,54 L53,54 L50,72 L64,50 L55,50 Z"
            android:fillColor="#FFD600" />

    </group>
</vector>
