<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:clipToOutline="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp">

        <!-- 顶部电流图标圆圈 -->
        <FrameLayout
            android:visibility="gone"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_dialog_btn_highlight">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/setting_current_calibration"
                android:src="@drawable/ic_electric_current"
                app:tint="#2196F3" />
        </FrameLayout>

        <!-- 弹窗标题 -->
        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/dialog_current_calibration_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 弹窗说明 -->
        <TextView
            android:id="@+id/tv_dialog_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/setting_current_calibration_desc"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12.5sp" />

        <!-- 实时采样状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dialog_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="底层硬件采样电流"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tv_raw_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="350 mA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="校准后瞬时电流"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tv_calibrated_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#2196F3"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    tools:text="700 mA" />
            </LinearLayout>
        </LinearLayout>

        <!-- 倍率选择标题与说明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/current_calibration_multiplier_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10的倍数档位"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/current_calibration_multiplier_desc"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11.5sp" />

        <!-- 倍率第一行：正向倍率 (1, 10, 100, 1000) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_mult_pos_1"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/selector_calibration_multiplier"
                android:button="@null"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/selector_calibration_multiplier_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_mult_pos_10"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_calibration_multiplier"
                android:button="@null"
                android:gravity="center"
                android:text="10"
                android:textColor="@color/selector_calibration_multiplier_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_mult_pos_100"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_calibration_multiplier"
                android:button="@null"
                android:gravity="center"
                android:text="100"
                android:textColor="@color/selector_calibration_multiplier_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_mult_pos_1000"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/selector_calibration_multiplier"
                android:button="@null"
                android:gravity="center"
                android:text="1000"
                android:textColor="@color/selector_calibration_multiplier_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 倍率第二行：反向倍率 (-1, -10, -100, -1000) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_mult_neg_1"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/selector_calibration_multiplier"
                android:button="@null"
                android:gravity="center"
                android:text="-1"
                android:textColor="@color/selector_calibration_multiplier_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_mult_neg_10"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_calibration_multiplier"
                android:button="@null"
                android:gravity="center"
                android:text="-10"
                android:textColor="@color/selector_calibration_multiplier_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_mult_neg_100"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_calibration_multiplier"
                android:button="@null"
                android:gravity="center"
                android:text="-100"
                android:textColor="@color/selector_calibration_multiplier_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_mult_neg_1000"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/selector_calibration_multiplier"
                android:button="@null"
                android:gravity="center"
                android:text="-1000"
                android:textColor="@color/selector_calibration_multiplier_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 开启双电芯 Switch 卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_calibration_dual_cell_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/current_calibration_dual_cell_desc"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_dual_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="0.82"
                android:scaleY="0.82"
                app:thumbTint="@color/selector_switch_thumb"
                app:trackTint="@color/selector_switch_track" />
        </LinearLayout>

        <!-- 极性反转 Switch 卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_calibration_invert_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/current_calibration_invert_desc"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_invert_polarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="0.82"
                android:scaleY="0.82"
                app:thumbTint="@color/selector_switch_thumb"
                app:trackTint="@color/selector_switch_track" />
        </LinearLayout>

        <!-- 库仑计差分推算 Switch 卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_calibration_coulomb_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/current_calibration_coulomb_desc"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_coulomb_fallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="0.82"
                android:scaleY="0.82"
                app:thumbTint="@color/selector_switch_thumb"
                app:trackTint="@color/selector_switch_track" />
        </LinearLayout>

        <!-- 底部按钮栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/cancel"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2196F3"
                android:text="@string/confirm"
                android:textColor="@android:color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
