<resources>
    <!-- 主题继承自 Material3，全部属性使用 @color/... 资源引用，确保 resourceId 有效 -->
    <style name="Theme.BatteryApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="materialSwitchStyle">@style/Widget.Battery.MaterialSwitch</item>
    </style>
    
    <!-- 全局 MaterialSwitch 样式：美观精致现代科技质感 -->
    <style name="Widget.Battery.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/selector_switch_thumb</item>
        <item name="trackTint">@color/selector_switch_track</item>
        <item name="trackDecorationTint">@color/selector_switch_track_outline</item>
    </style>
    
    <style name="TextAppearance.TabTitle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- 从右上角展开的弹窗动画样式 -->
    <style name="Animation.PopupTopRight" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/anim_popup_top_right_enter</item>
        <item name="android:windowExitAnimation">@anim/anim_popup_top_right_exit</item>
    </style>

    <!-- 气泡在锚点上方弹出时的平滑进入与退出动画样式 -->
    <style name="Animation.BubbleTooltip.Above" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/anim_bubble_tooltip_above_enter</item>
        <item name="android:windowExitAnimation">@anim/anim_bubble_tooltip_above_exit</item>
    </style>

    <!-- 气泡在锚点下方弹出时的平滑进入与退出动画样式 -->
    <style name="Animation.BubbleTooltip.Below" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/anim_bubble_tooltip_below_enter</item>
        <item name="android:windowExitAnimation">@anim/anim_bubble_tooltip_below_exit</item>
    </style>

    <style name="ShapeAppearance_SceneHeader" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">14dp</item>
        <item name="cornerSizeTopRight">14dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
