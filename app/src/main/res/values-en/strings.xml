    <string name="power_guide_process_content">The discharge process chart shows the battery level curve over time since boot or last discharge, marking active apps during high-drain periods.</string>
    <string name="power_guide_scene_title">Usage Scenarios Guide</string>
    <string name="power_guide_scene_content">Usage scenarios breakdown displays foreground runtime, average power consumption, and operating temperature for each active app.</string>
    <string name="power_guide_overview_title">Discharge Metrics Guide</string>
    <string name="power_guide_overview_content">• Discharge Power: Shows screen-on average power, overall average power, and standby power since discharge (Watts).\n\n• Discharge Time: Tracks screen-on duration, screen-off standby duration, and total discharge duration.\n\n• Battery Life: Estimates remaining battery life for screen-on, mixed usage, and standby based on current battery energy and measured power.</string>

    <!-- Power Reset Dialog -->
    <string name="dialog_power_reset_title">Reset Power Statistics?</string>
    <string name="dialog_power_reset_desc">Resetting will clear all sampling data, discharge curves, and app usage rankings for the current discharge cycle, starting fresh from the current battery level. Saved history snapshots will not be affected.</string>
    <string name="dialog_power_reset_confirm_btn">Reset Now</string>
