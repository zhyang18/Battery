<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_power"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 原生可折叠顶部 AppBar：承载标题栏与功耗卡片联动效果 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:backgroundTint="@android:color/transparent"
        app:elevation="0dp">

        <!-- 可折叠标题栏区域（向上滚动时折叠滚出屏幕） -->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:background="@android:color/transparent"
            app:contentScrim="@android:color/transparent"
            app:statusBarScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- 展开时完整显示的标题栏区域 -->
            <LinearLayout
                android:id="@+id/layout_expanded_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 顶部标题栏：支持双模切换与状态指示，统一60dp高度与18dp顶边距 -->
                <LinearLayout
                    android:id="@+id/layout_title_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp">

                    <!-- 标题与游标时间横向容器 -->
                    <LinearLayout
                        android:id="@+id/layout_title_text_container"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_power_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:text="@string/power_stats_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_power_cursor_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:ellipsize="end"
                            android:layout_gravity="center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:visibility="gone"
                            tools:text="(00:57:34)"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- 电量显示单位切换胶囊按钮（Wh <-> mAh，饱满度与微底座呼应） -->
                    <LinearLayout
                        android:id="@+id/btn_power_unit_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_power_unit_badge"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/ic_swap_horiz"
                            app:tint="?android:attr/textColorPrimary" />

                        <TextView
                            android:id="@+id/tv_power_unit_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wh"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 右侧说明文档图标（带微底座纯线条问号） -->
                    <ImageView
                        android:id="@+id/btn_power_guide"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_power_icon_circle_badge"
                        android:clickable="true"
                        android:contentDescription="@string/power_guide_stats_dialog_title"
                        android:focusable="true"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_power_guide_badge"
                        app:tint="?android:attr/textColorPrimary" />

                    <!-- 右侧耗电历史记录按钮（带微底座纯折线趋势） -->
                    <ImageView
                        android:id="@+id/btn_power_history"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_power_icon_circle_badge"
                        android:clickable="true"
                        android:contentDescription="@string/power_history_title"
                        android:focusable="true"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_power_history_badge"
                        app:tint="?android:attr/textColorPrimary" />

                    <!-- 右侧充电历史记录按钮（带微底座纯闪电） -->
                    <ImageView
                        android:id="@+id/btn_charging_history"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_power_icon_circle_badge"
                        android:clickable="true"
                        android:contentDescription="@string/charging_history_title"
                        android:focusable="true"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_charging_history_badge"
                        app:tint="?android:attr/textColorPrimary" />

                    <!-- 右侧重置统计图标（带微底座双向对称循环重置箭头） -->
                    <ImageView
                        android:id="@+id/btn_power_clear"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_power_icon_circle_badge"
                        android:clickable="true"
                        android:contentDescription="@string/power_stats_reset_btn"
                        android:focusable="true"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_power_reset_sync"
                        app:tint="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- 唯一的全局核心功耗指标卡片：移至 AppBarLayout 直接子节点，无 scrollFlags 实现折叠常驻吸顶 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_power_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:visibility="gone"
            app:cardBackgroundColor="#14888888"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingTop="8dp"
                android:paddingEnd="3dp"
                android:paddingBottom="8dp">

                <!-- 第一行：亮屏数据（前置亮色太阳图标，时长占比 / 功耗+放电速度 / 能量占比） -->
                <LinearLayout
                    android:id="@+id/layout_metric_screen_on_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 左框：亮屏图标与时长占比（等比 1/3） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_icon_screen_on"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/power_header_screen_on"
                            android:src="@drawable/ic_power_screen_on" />

                        <TextView
                            android:id="@+id/tv_metric_screen_on_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="13m44s(45.1%)" />
                    </LinearLayout>

                    <!-- 中框：功耗与放电速度（等比 1/3，内部两列等分） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_metric_screen_on_power"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:layout_marginStart="5dp"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="1.77W" />

                        <TextView
                            android:id="@+id/tv_metric_screen_on_speed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingEnd="5dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="10.5%/h" />
                    </LinearLayout>

                    <!-- 右框：能量占比（等比 1/3） -->
                    <TextView
                        android:id="@+id/tv_metric_screen_on_energy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0.406Wh(45.1%)" />
                </LinearLayout>

                <!-- 第二行：息屏数据（前置暗色太阳图标，时长占比 / 功耗+放电速度 / 能量占比） -->
                <LinearLayout
                    android:id="@+id/layout_metric_screen_off_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 左框：息屏图标与时长占比（等比 1/3） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_icon_screen_off"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/power_header_screen_off"
                            android:src="@drawable/ic_power_screen_off" />

                        <TextView
                            android:id="@+id/tv_metric_screen_off_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="49m55s(54.9%)" />
                    </LinearLayout>

                    <!-- 中框：功耗与放电速度（等比 1/3，内部两列等分） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_metric_screen_off_power"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:layout_marginStart="5dp"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0.59W" />

                        <TextView
                            android:id="@+id/tv_metric_screen_off_speed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingEnd="5dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="1.8%/h" />
                    </LinearLayout>

                    <!-- 右框：能量占比（等比 1/3） -->
                    <TextView
                        android:id="@+id/tv_metric_screen_off_energy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0.494Wh(54.9%)" />
                </LinearLayout>

                <!-- 第三行：全局数据（前置半亮半暗太阳图标，时长占比 / 功耗+放电速度 / 能量占比） -->
                <LinearLayout
                    android:id="@+id/layout_metric_global_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 左框：全局图标与时长占比（等比 1/3） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_icon_global"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/power_header_global"
                            android:src="@drawable/ic_power_global" />

                        <TextView
                            android:id="@+id/tv_metric_global_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="1h03m(100%)" />
                    </LinearLayout>

                    <!-- 中框：功耗与放电速度（等比 1/3，内部两列等分） -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_metric_global_power"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:singleLine="true"
                            android:layout_marginStart="5dp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0.85W" />

                        <TextView
                            android:id="@+id/tv_metric_global_speed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:paddingEnd="5dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end|center_vertical"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="7.2%/h" />
                    </LinearLayout>

                    <!-- 右框：能量占比（等比 1/3） -->
                    <TextView
                        android:id="@+id/tv_metric_global_energy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0.900Wh(100%)" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 主内容滚动容器（SwipeRefreshLayout 直接包含主 RecyclerView） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_app_usage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
