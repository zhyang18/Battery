<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部统一大标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
             />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="32dp">

            <!-- 1. 用户界面 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_ui"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目 0: 语言设置 (Language) -->
            <LinearLayout
                android:id="@+id/layout_language_setting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_detection"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_language"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_current_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    tools:text="简体中文" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目 1: 跟随系统主题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_palette"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_follow_system_theme"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_follow_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 条目 2: 开启暗黑模式 -->
            <LinearLayout
                android:id="@+id/layout_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_moon"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_dark_mode"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 2. 数据与刷新 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_refresh"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目 3: 开启实时自动刷新 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_auto_refresh"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 条目 4: 刷新时间间隔 -->
            <LinearLayout
                android:id="@+id/layout_interval_setting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_timer"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_refresh_interval"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <TextView
                    android:id="@+id/tv_current_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    tools:text="2 秒" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目: 耗电统计检测模式 -->
            <LinearLayout
                android:id="@+id/layout_power_mode_setting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_power"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_power_mode"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_current_power_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13.5sp"
                    tools:text="⚡ Shizuku 模式" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 3. Shizuku 提权 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_shizuku"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目 5: 启用 Shizuku 提权读取 -->
            <LinearLayout
                android:id="@+id/layout_shizuku_auth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_hashtag"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shizuku_service_name"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                         />

                    <TextView
                        android:id="@+id/tv_shizuku_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/shizuku_status_checking"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_shizuku_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/shizuku_action_authorize"
                    android:textColor="@color/nav_item_selected"
                    android:textSize="14sp"
                     />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 4. 数据备份与恢复 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_backup"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目: 导出数据备份 -->
            <LinearLayout
                android:id="@+id/layout_export_backup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_backup_export"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_export_backup"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                         />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/setting_export_backup_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目: 导入并恢复数据 -->
            <LinearLayout
                android:id="@+id/layout_restore_backup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_backup_restore"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_restore_backup"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                         />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/setting_restore_backup_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 5. 关于 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_about"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目 6: 电池健康度计算方式说明 -->
            <LinearLayout
                android:id="@+id/layout_health_calc_info"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_detection"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_health_guide"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目 7: 应用版本 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_app_version"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    tools:text="v1.1.1" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
