<?xml version="1.0" encoding="utf-8"?>
<com.battery.analysis.ui.view.BubbleTooltipLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="6dp"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_bubble_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/popup_item_text"
        android:textSize="13sp" />
</com.battery.analysis.ui.view.BubbleTooltipLayout>
