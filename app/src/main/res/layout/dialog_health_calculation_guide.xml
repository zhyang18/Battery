<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="15dp"
    android:paddingVertical="20dp">

    <!-- 弹窗标题与副标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="电池健康度计算说明"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="SoH 核心算法与三大数据源采集原理"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12.5sp" />

    <!-- 滚动内容区（限制最大高度，确保弹窗顶部和底部留出舒适距离） -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:maxHeight="360dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 卡片 1: 核心公式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📐 黄金计算公式"
                    android:textColor="#2196F3"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dialog_formula_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="健康度 (%) = (充满容量 ÷ 设计容量) × 100%"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="电池健康度（State of Health）是衡量锂电池当前可用最大电量相比出厂设计额定容量的衰减百分比。"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 卡片 2: 三大数据源采集机制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔬 三大数据源采集机制"
                    android:textColor="#818CF8"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- 系统 API -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. 系统原生 API"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="基于 BatteryManager 框架。通过当前电量与电荷量等比反推满电容量，通过反射读取出厂配置。部分厂商未对外开放底层电芯节点。"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <!-- Shizuku -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="2. Shizuku 底层驱动节点 (高精度推荐)"
                    android:textColor="#818CF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="通过 ADB 提权直接读取 Linux 内核驱动节点（charge_full、charge_full_design、cycle_count）及电量计 IC 硬件寄存器，数据精度最高。"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <!-- 错误报告 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="3. 错误报告 (Bugreport)"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="提取自系统底层 dump 的权威 getHealthInfo 快照，包含系统电源管理框架维护的健康数据。"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 卡片 3: 健康度衰减标准与提示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dialog_card"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 健康度衰减评估标准"
                    android:textColor="#10B981"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• 95% ~ 100%：极佳状态，电池几乎无衰减\n• 85% ~ 95%：良好状态，正常日常使用损耗\n• 80% ~ 85%：轻度衰减，续航体验可能略有下降\n• &lt; 80%：重度衰减，建议根据实际续航考虑更换电池"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💡 提示：充满容量会随环境温度（低温 &lt; 15℃ 或高温 &gt; 35℃）产生微小浮动，建议在室温充满电后查看数据。"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部确认按钮 -->
    <TextView
        android:id="@+id/btn_dialog_guide_close"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dialog_btn_delete"
        android:backgroundTint="#2196F3"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="我知道了"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
