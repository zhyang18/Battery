<?xml version="1.0" encoding="utf-8"?>
<com.battery.analysis.ui.view.BubbleTooltipLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="6dp"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_bubble_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tv_bubble_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/popup_item_text"
            android:textSize="13sp" />
    </androidx.core.widget.NestedScrollView>
</com.battery.analysis.ui.view.BubbleTooltipLayout>

