<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2.5dp"
    android:background="@drawable/bg_diag_sub_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="9dp"
    android:paddingVertical="8dp">

    <!-- 区间电量范围（固定宽度 80dp 确保 95% - 100% 绝对不出现省略号截断） -->
    <TextView
        android:id="@+id/tv_bin_range_label"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:singleLine="true"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="95% - 100%" />

    <!-- 数据源类型徽章列（固定列宽 38dp 并居中对齐，严防换行） -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp">

        <TextView
            android:id="@+id/tv_bin_source_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_diag_pill_badge"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1.5dp"
            android:singleLine="true"
            android:maxLines="1"
            android:textSize="9.5sp"
            android:textStyle="bold"
            tools:text="实测" />
    </FrameLayout>

    <!-- 样本统计状态或依据说明（占用中间自适应弹性空间，靠右对齐，精简字串防截断） -->
    <TextView
        android:id="@+id/tv_bin_sample_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        android:gravity="end|center_vertical"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="10.5sp"
        tools:text="1次 · 25℃" />

    <!-- 释放能量数值（固定右侧，设置最小宽度保证 Wh 绝对不被裁切截断） -->
    <TextView
        android:id="@+id/tv_bin_energy_val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="58dp"
        android:gravity="end|center_vertical"
        android:singleLine="true"
        android:textColor="#10b981"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="~1.370 Wh" />

</LinearLayout>
