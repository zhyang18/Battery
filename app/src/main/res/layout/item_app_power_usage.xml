<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- 应用图标 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop"
        tools:src="@mipmap/ic_launcher" />

    <!-- 文本信息列 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:orientation="vertical">

        <!-- 应用名称与活跃圆点 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/view_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_green" />

            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="系统桌面" />
        </LinearLayout>

        <!-- 功耗与 AVG 温度参数行 -->
        <TextView
            android:id="@+id/tv_avg_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.5dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="12sp"
            android:maxLines="1"
            tools:text="AVG: 0.67W, 36.0℃" />
    </LinearLayout>

    <!-- 右侧两行：上方前后台时长，下方前后台消耗能量与 MAX 最高运行温度 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <!-- 前台时长 与 后台时长 容器 -->
        <LinearLayout
            android:id="@+id/layout_duration_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <!-- 前台时长组：绿色小圆点 + 前台时间 -->
            <LinearLayout
                android:id="@+id/layout_fg_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_fg_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_dot_green" />

                <TextView
                    android:id="@+id/tv_fg_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    tools:text="6h7m" />
            </LinearLayout>

            <!-- 中间竖线分隔符：仅在前后台时长同时显示时呈现 -->
            <TextView
                android:id="@+id/tv_duration_divider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="|"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 后台时长组：蓝色小圆点 + 后台时间 -->
            <LinearLayout
                android:id="@+id/layout_bg_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_bg_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_dot_blue" />

                <TextView
                    android:id="@+id/tv_bg_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    tools:text="1h20m" />
            </LinearLayout>
        </LinearLayout>

        <!-- 移动到时间下方的 消耗能量 | MAX 最高运行温度 -->
        <TextView
            android:id="@+id/tv_app_energy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.5dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="0.250Wh | MAX: 39.0℃" />
    </LinearLayout>

</LinearLayout>
