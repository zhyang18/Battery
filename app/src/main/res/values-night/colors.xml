<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局白色（暗色模式下调为 80% 白色，避免高对比度刺眼） -->
    <color name="white">#CCCCCC</color>
    <color name="text_primary_dark">#CCCCCC</color>

    <!-- 深色模式下的下拉弹窗背景（精致深灰）与文字（80% 白色） -->
    <color name="popup_bg">#27272A</color>
    <color name="popup_item_text">#CCCCCC</color>

    <!-- 弹窗分层色彩体系（深色模式：分层明显，质感细腻） -->
    <color name="dialog_surface_bg">#1E1E22</color>
    <color name="dialog_surface_stroke">#33333C</color>
    <color name="dialog_card_bg">#28282E</color>
    <color name="dialog_card_stroke">#3C3C46</color>
    <color name="dialog_badge_bg">#172A40</color>
    <color name="dialog_badge_stroke">#25456A</color>

    <!-- 耗电统计卡片状态图标色彩体系（深色模式：对标图二亮白与暗灰） -->
    <color name="power_icon_screen_on">#CBD5E1</color>
    <color name="power_icon_screen_off">#64748B</color>

    <!-- 已卸载应用通用图标颜色体系（深色模式） -->
    <color name="uninstalled_icon_bg">#28282E</color>
    <color name="uninstalled_icon_fg">#94A3B8</color>

    <!-- 未命中/默认应用通用图标颜色体系（深色模式） -->
    <color name="default_app_icon_bg">#28282E</color>
    <color name="default_app_icon_fg">#94A3B8</color>

    <!-- 切换开关（Switch）色彩体系 - 深色模式：深邃高质感科技蓝 -->
    <color name="switch_track_checked">#2196F3</color>
    <color name="switch_track_unchecked">#27272A</color>
    <color name="switch_track_checked_disabled">#802196F3</color>
    <color name="switch_track_unchecked_disabled">#6627272A</color>
    <color name="switch_thumb_checked">#FFFFFF</color>
    <color name="switch_thumb_unchecked">#A1A1AA</color>
    <color name="switch_thumb_checked_disabled">#80FFFFFF</color>
    <color name="switch_thumb_unchecked_disabled">#66A1A1AA</color>
    <color name="switch_track_outline_checked">@android:color/transparent</color>
    <color name="switch_track_outline_unchecked">#3F3F46</color>
</resources>
