<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_capacity_overview_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#14888888"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <!-- 1. 默认常驻首行：单行极简速览态（点击触发展开与收缩） -->
        <LinearLayout
            android:id="@+id/layout_collapsed_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 核心电量与容量数值展示 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_collapsed_charge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="预估满电容量: 学习中" />

                <TextView
                    android:id="@+id/tv_collapsed_energy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 右侧：收敛/自学习成熟度圆角胶囊徽章（高度饱满增加） -->
            <TextView
                android:id="@+id/tv_collapsed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textColor="#10b981"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="自学习中(0/5)" />

            <!-- 展开/折叠指示箭头 -->
            <ImageView
                android:id="@+id/iv_expand_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- 2. 可平滑展开的双轨卡片详情区域（默认折叠） -->
        <LinearLayout
            android:id="@+id/layout_expanded_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#14888888" />

            <!-- 双轨对称子卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- 左卡片：当前剩余可用电荷量 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_capacity_sub_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capacity_remaining_charge_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_val_remaining_charge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="3,420 mAh" />

                    <TextView
                        android:id="@+id/tv_sub_remaining_charge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="9sp"
                        tools:text="物理电荷 · 68%" />
                </LinearLayout>

                <!-- 右卡片：当前剩余可用能量 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_capacity_sub_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capacity_remaining_energy_title"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_val_remaining_energy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#10b981"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="13.17 Wh" />

                    <TextView
                        android:id="@+id/tv_sub_remaining_energy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="9sp"
                        tools:text="3.85V 标称工作平台" />
                </LinearLayout>
            </LinearLayout>

            <!-- 底部满充基准与诊断档案入口行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/capacity_fcc_baseline_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_val_fcc_baseline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="4,980 mAh" />

                <TextView
                    android:id="@+id/tv_val_fcc_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3.5dp"
                    android:textColor="#10b981"
                    android:textSize="9.5sp"
                    tools:text="🌱 自学习中" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 进入全景科学诊断抽屉按钮 -->
                <TextView
                    android:id="@+id/btn_open_diagnosis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#14888888"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/capacity_open_diagnosis"
                    android:textColor="#10b981"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
