<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:minWidth="180dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_dropdown"
    android:clipToOutline="true"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <!-- 不采样 -->
    <TextView
        android:id="@+id/tv_opt_never"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_dropdown_item_ripple"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/interval_never"
        android:textColor="@color/popup_item_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 智能省电 (推荐) -->
    <TextView
        android:id="@+id/tv_opt_smart_eco"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_dropdown_item_ripple"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/interval_smart_eco"
        android:textColor="@color/popup_item_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 15 秒 -->
    <TextView
        android:id="@+id/tv_opt_15s"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_dropdown_item_ripple"
        android:gravity="center"
        android:text="@string/interval_15s"
        android:textColor="@color/popup_item_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 30 秒 -->
    <TextView
        android:id="@+id/tv_opt_30s"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_dropdown_item_ripple"
        android:gravity="center"
        android:text="@string/interval_30s"
        android:textColor="@color/popup_item_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 60 秒 -->
    <TextView
        android:id="@+id/tv_opt_60s"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_dropdown_item_ripple"
        android:gravity="center"
        android:text="@string/interval_60s"
        android:textColor="@color/popup_item_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 2 分钟 (120 秒) -->
    <TextView
        android:id="@+id/tv_opt_120s"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_dropdown_item_ripple"
        android:gravity="center"
        android:text="@string/interval_120s"
        android:textColor="@color/popup_item_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 5 分钟 (300 秒) -->
    <TextView
        android:id="@+id/tv_opt_300s"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_dropdown_item_ripple"
        android:gravity="center"
        android:text="@string/interval_300s"
        android:textColor="@color/popup_item_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
