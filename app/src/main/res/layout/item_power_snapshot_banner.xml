<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_power_snapshot_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_dialog_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/tv_power_snapshot_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#2196F3"
        android:textSize="12.5sp"
        android:textStyle="bold"
        tools:text="📌 正在查看耗电历史快照: 2026-09-04 13:30:22" />

    <TextView
        android:id="@+id/btn_power_restore_realtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_history_badge"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="@string/btn_restore_realtime"
        android:textColor="#2196F3"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
