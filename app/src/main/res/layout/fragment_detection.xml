<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部统一大标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 顶部三大子 Tab 页签：系统api、Shizuku、错误报告 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?android:attr/colorBackground"
        app:tabGravity="fill"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextAppearance="@style/TextAppearance.TabTitle"
        app:tabTextColor="?android:attr/textColorSecondary" />

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A888888" />

    <!-- 历史记录快照查看状态横幅 -->
    <LinearLayout
        android:id="@+id/layout_history_snapshot_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#142196F3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="9dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_history_snapshot_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#2196F3"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="📌 正在查看历史快照: 2026-08-18 15:30:22" />

        <TextView
            android:id="@+id/btn_restore_realtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_history_badge"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/btn_restore_realtime"
            android:textColor="#2196F3"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 下拉刷新容器：支持全屏任意位置向下拉动刷新，并自适应 ViewPager2 横滑防误触 -->
    <com.battery.analysis.ui.view.ViewPagerSwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ViewPager2 容器：承载三 Tab 页面并支持左右滑动 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/detection_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.battery.analysis.ui.view.ViewPagerSwipeRefreshLayout>

</LinearLayout>
