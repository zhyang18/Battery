<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_discharge_speed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:weightSum="3">

    <!-- 卡片 1：亮屏放电速度 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_screen_on_speed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="8dp">

            <!-- 第一行：放电速度百分比数值（靠左） + 亮屏标签文字（靠右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 每小时放电占比百分比数值 (如 5.6%/h) -->
                <TextView
                    android:id="@+id/tv_screen_on_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="5.6%/h" />

                <TextView
                    android:id="@+id/tv_screen_on_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:text="@string/power_header_screen_on"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：剩余续航 / 满电预测续航时间（居中斜杠分割符，两侧数值样式完全一致） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_screen_on_remaining"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="04h37m" />

                <TextView
                    android:id="@+id/tv_screen_on_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="/"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_screen_on_remaining_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="15h40m" />
            </LinearLayout>

            <!-- 第三行：剩余续航与满电续航进度占比指示条 (高度 5dp) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_screen_on_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:max="1000"
                app:indicatorColor="@color/power_remaining_progress_indicator"
                app:indicatorInset="0dp"
                app:trackColor="#20888888"
                app:trackCornerRadius="2.5dp"
                app:trackThickness="5dp"
                tools:progress="510" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 卡片 2：息屏放电速度 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_screen_off_speed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="8dp">

            <!-- 第一行：放电速度百分比数值（靠左） + 息屏标签文字（靠右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 每小时放电占比百分比数值 (如 0.0%/h) -->
                <TextView
                    android:id="@+id/tv_screen_off_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="0.0%/h" />

                <TextView
                    android:id="@+id/tv_screen_off_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:text="@string/power_header_screen_off"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：剩余续航 / 满电预测续航时间（居中斜杠分割符，两侧数值样式完全一致） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_screen_off_remaining"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="01d00h" />

                <TextView
                    android:id="@+id/tv_screen_off_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="/"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_screen_off_remaining_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="03d09h" />
            </LinearLayout>

            <!-- 第三行：剩余续航与满电续航进度占比指示条 (高度 5dp) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_screen_off_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:max="1000"
                app:indicatorColor="@color/power_remaining_progress_indicator"
                app:indicatorInset="0dp"
                app:trackColor="#20888888"
                app:trackCornerRadius="2.5dp"
                app:trackThickness="5dp"
                tools:progress="650" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 卡片 3：全局放电速度 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_global_speed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#14888888"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="8dp">

            <!-- 第一行：放电速度百分比数值（靠左） + 全局标签文字（靠右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 每小时放电占比百分比数值 (如 2.2%/h) -->
                <TextView
                    android:id="@+id/tv_global_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="2.2%/h" />

                <TextView
                    android:id="@+id/tv_global_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:text="@string/power_header_global"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第二行：剩余续航 / 满电预测续航时间（居中斜杠分割符，两侧数值样式完全一致） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_global_remaining"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="11h14m" />

                <TextView
                    android:id="@+id/tv_global_divider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="/"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_global_remaining_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="01d04h" />
            </LinearLayout>

            <!-- 第三行：剩余续航与满电续航进度占比指示条 (高度 5dp) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_global_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:max="1000"
                app:indicatorColor="@color/power_remaining_progress_indicator"
                app:indicatorInset="0dp"
                app:trackColor="#20888888"
                app:trackCornerRadius="2.5dp"
                app:trackThickness="5dp"
                tools:progress="450" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
