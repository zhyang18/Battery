<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部统一大标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
             />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="65dp">

            <!-- 1. 用户界面 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_ui"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目 0: 语言设置 (Language) -->
            <LinearLayout
                android:id="@+id/layout_language_setting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_detection"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_language"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_current_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    tools:text="简体中文" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目 1: 跟随系统主题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_palette"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_follow_system_theme"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_follow_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 条目 2: 开启暗黑模式 -->
            <LinearLayout
                android:id="@+id/layout_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_moon"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_dark_mode"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 2. 数据与刷新 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_refresh"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目 3: 开启实时自动刷新 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_auto_refresh"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 条目 4: 刷新时间间隔 -->
            <LinearLayout
                android:id="@+id/layout_interval_setting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_timer"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_refresh_interval"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <TextView
                    android:id="@+id/tv_current_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    tools:text="2 秒" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目 4.5: 充电时保持屏幕常亮 -->
            <LinearLayout
                android:id="@+id/layout_charging_keep_screen_on_setting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lightbulb_outline"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_charging_keep_screen_on"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_charging_keep_screen_on"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 条目: 耗电统计检测模式 -->
            <LinearLayout
                android:id="@+id/layout_power_mode_setting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_power"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_power_mode"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_current_power_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13.5sp"
                    tools:text="Shizuku 模式" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目: 曲线采样精度 -->
            <LinearLayout
                android:id="@+id/layout_sampling_mode_setting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_battery_power"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_sampling_mode"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_current_sampling_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13.5sp"
                    tools:text="🍃 极限省电 (默认)" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 3. Shizuku 提权 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_shizuku"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目 5: 启用 Shizuku 提权读取 -->
            <LinearLayout
                android:id="@+id/layout_shizuku_auth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_hashtag"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shizuku_service_name"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                         />

                    <TextView
                        android:id="@+id/tv_shizuku_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/shizuku_status_checking"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_shizuku_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/shizuku_action_authorize"
                    android:textColor="@color/nav_item_selected"
                    android:textSize="14sp"
                     />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 后台常驻与保活防杀 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_keep_alive_category"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp" />

            <!-- 条目: 特权独立守护进程 (终极防杀) -->
            <LinearLayout
                android:id="@+id/card_daemon_keep_alive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <!-- 头部：图标 + 标题 + 运行状态胶囊 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/nav_item_selected" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/settings_daemon_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_daemon_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_btn"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        tools:text="运行中 (Root)" />
                </LinearLayout>

                <!-- 描述文案 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_daemon_desc"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11.5sp" />

                <!-- 守护进程动态详细信息 (PID、已拉活次数) -->
                <TextView
                    android:id="@+id/tv_daemon_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/nav_item_selected"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="PID: 12345 | 已成功自愈拉活: 3 次"
                    tools:visibility="visible" />

                <!-- 底部操作按钮栏 (启动/停止、ADB 指南) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_daemon_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_dialog_btn_primary"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/settings_daemon_btn_start"
                        android:textColor="@color/white"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_daemon_adb_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_btn"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/settings_daemon_btn_adb"
                        android:textColor="@color/nav_item_selected"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 条目: 常驻通知栏监控 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_keep_alive_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_keep_alive_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_keep_alive_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 条目: 亮屏监控刷新间隔 -->
            <LinearLayout
                android:id="@+id/layout_screen_on_interval"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_screen_on_interval_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_screen_on_interval_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_current_screen_on_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13.5sp"
                    tools:text="3 秒" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目: 息屏待机采样间隔 -->
            <LinearLayout
                android:id="@+id/layout_screen_off_interval"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_battery_power"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_screen_off_interval_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_screen_off_interval_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_current_screen_off_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13.5sp"
                    tools:text="30 秒" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目: 开机自动启动监控 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_power"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_boot_start_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_boot_start_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_boot_auto_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.82"
                    android:scaleY="0.82"
                    app:thumbTint="@color/selector_switch_thumb"
                    app:trackTint="@color/selector_switch_track" />
            </LinearLayout>

            <!-- 条目: 忽略电池优化白名单 -->
            <LinearLayout
                android:id="@+id/layout_battery_optimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_battery_power"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_battery_optimization_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_battery_optimization_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_battery_optimization_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/nav_item_selected"
                    android:textSize="13.5sp"
                    tools:text="去设置" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目: 后台防杀与锁定指南 -->
            <LinearLayout
                android:id="@+id/layout_lock_recents_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_help_circle"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_lock_recents_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_lock_recents_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 4. 数据备份与恢复 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_backup"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目: 导出数据备份 -->
            <LinearLayout
                android:id="@+id/layout_export_backup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_backup_export"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_export_backup"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                         />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/setting_export_backup_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目: 导入并恢复数据 -->
            <LinearLayout
                android:id="@+id/layout_restore_backup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_backup_restore"
                    app:tint="?android:attr/textColorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_restore_backup"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                         />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/setting_restore_backup_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 5. 关于 分类 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_about"
                android:textColor="@color/nav_item_selected"
                android:textSize="13sp"
                 />

            <!-- 条目 6: 电池健康度计算方式说明 -->
            <LinearLayout
                android:id="@+id/layout_health_calc_info"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_detection"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_health_guide"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- 条目 7: 应用版本 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_setting_card_item"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="?android:attr/textColorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/setting_app_version"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                     />

                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    tools:text="v1.1.1" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
