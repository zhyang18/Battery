    <!-- Health Calculation Guide Dialog -->
    <string name="guide_title">Battery Health Guide</string>
    <string name="guide_subtitle">SoH Core Algorithm &amp; 3 Data Sources Principle</string>
    <string name="guide_formula_title">📐 Golden Calculation Formula</string>
    <string name="guide_formula_badge" formatted="false">Health (%) = (Full Capacity ÷ Design Capacity) × 100%</string>
    <string name="guide_formula_desc">State of Health (SoH) measures the maximum available capacity of the battery compared to its factory rated design capacity.</string>
    <string name="guide_sources_title">🔬 3 Data Acquisition Mechanisms</string>
    <string name="guide_source_1_title">1. System Native API</string>
    <string name="guide_source_1_desc">Based on the BatteryManager framework. Calculates full charge capacity proportionally from current level and charge counter, reflecting factory configs.</string>
    <string name="guide_source_2_title">2. Shizuku Kernel Node (High Precision)</string>
    <string name="guide_source_2_desc">Reads Linux kernel driver nodes (charge_full, charge_full_design, cycle_count) and fuel gauge IC registers via ADB privileges for highest precision.</string>
    <string name="guide_source_3_title">3. Bugreport Log Snapshot</string>
    <string name="guide_source_3_desc">Authoritative getHealthInfo snapshots dumped from system bugreport, containing official Android power management framework health data.</string>
    <string name="guide_eval_title">📊 Health Decay Evaluation Standard</string>
    <string name="guide_eval_desc" formatted="false">• 95% ~ 100%: Excellent state, almost no battery decay\n• 85% ~ 95%: Good state, normal daily degradation\n• 80% ~ 85%: Mild decay, slight battery life reduction\n• &lt; 80%: Heavy decay, battery replacement recommended</string>
    <string name="guide_tip_temp">💡 Tip: Full charge capacity fluctuates slightly with ambient temperature (&lt;15°C or &gt;35°C). It is recommended to inspect at room temperature after a full charge.</string>

